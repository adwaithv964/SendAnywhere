# ─── Required ─────────────────────────────────────────────────────────────────
# 32-byte random hex key used to seal per-transfer encryption keys at rest.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value secret and never commit it to source control.
SERVER_MASTER_KEY=paste_your_64_hex_char_key_here

# ─── Optional ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
EXPIRY_MINUTES=30
MAX_FILE_SIZE=2147483648
MAX_FILES=50
# DATA_DIR=/path/to/persistent/storage
